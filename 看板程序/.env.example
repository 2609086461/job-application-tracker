# 嵌入式校招看板 - 环境变量
# ============================================================
# 获取方式见 README.md
# ============================================================
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_APP_TOKEN=app_xxx
MAIN_TABLE_ID=tbl_xxx

# 邮箱地址和 OAuth 回调均由部署者配置，不在源码中使用个人默认值
QQ_MAIL_ADDRESS=your-account@qq.com
FEISHU_OAUTH_REDIRECT_URI=https://tracker.example.com/api/feishu/oauth/callback

# 定时邮件智能分析（密钥文件必须位于 Git 之外且权限为 0600）
OPENAI_API_KEY_FILE=/etc/job-tracker/openai-api-key
MAIL_LLM_MODEL=gpt-5.6-terra

# 飞书截止提醒：应用需要对目标日历拥有 writer 或 owner 权限
# Optional: leave blank to use the app's primary calendar.
FEISHU_CALENDAR_ID=
# Stable union ID of the Feishu user who should receive deadline events.
FEISHU_REMINDER_USER_ID=on_xxx
FEISHU_REMINDER_USER_ID_TYPE=union_id
