# 嵌入式校招看板 - 环境变量
# ============================================================
# 获取方式见 README.md
# ============================================================
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
MAIN_TABLE_ID=

# 邮箱地址和 OAuth 回调均由部署者配置，不在源码中使用个人默认值
QQ_MAIL_ADDRESS=
FEISHU_OAUTH_REDIRECT_URI=

# 邮件分析默认使用已登录的 Codex CLI 当前可用默认模型，不写死模型名称。
# 只有确认目标模型在当前 Codex 账号可用时才填写具体名称。
MAIL_CODEX_FAST_MODEL=auto
MAIL_CODEX_REVIEW_MODEL=auto

# 飞书截止提醒：应用需要对目标日历拥有 writer 或 owner 权限
# Optional: leave blank to use the app's primary calendar.
FEISHU_CALENDAR_ID=
# Stable union ID of the Feishu user who should receive deadline events.
FEISHU_REMINDER_USER_ID=
FEISHU_REMINDER_USER_ID_TYPE=union_id
